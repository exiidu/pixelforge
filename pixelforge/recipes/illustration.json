{
  "target": { "width": 64, "height": 64 },
  "preprocess": {
    "bilateral": { "enable": false },
    "levels": {
      "saturation": 1.0,
      "contrast": 1.0,
      "bright_contrast": 0.0,
      "bright_start": 0.6
    },
    "matting": { "enable": false }
  },
  "structure": {
    "edge": { "dog_sigma": 1.2, "sobel_weight": 0.5 },
    "lineart": { "mode": "xdog", "xdog": { "p": 20, "epsilon": 0.6 } }
  },
  "ai": { "enable": false },
  "sampling": { "mode": "weighted_mode", "weights": { "edge": 2.0, "dark": 1.5, "contrast": 1.0 } },
  "quantize": {
    "palette": { "source": "extract", "max_colors": 32 },
    "dither": { "mode": "off" }
  },
  "ink": {
    "enable": true,
    "opacity": 1.0,
    "recolor": { "mode": "selective", "darken": 0.25 }
  },
  "post": { "despeckle": 1 }
}
