{
  "target": { "width": 64, "height": 64 },
  "preprocess": {
    "bilateral": { "enable": true, "radius": 3, "strength": 0.6 },
    "levels": { "saturation": 1.15, "contrast": 1.05 },
    "matting": { "enable": false }
  },
  "structure": {
    "edge": { "dog_sigma": 1.2, "sobel_weight": 0.5 },
    "lineart": { "mode": "off" }
  },
  "ai": { "enable": false },
  "sampling": { "mode": "weighted_mode", "weights": { "edge": 2.0, "dark": 1.5, "contrast": 1.0 } },
  "quantize": {
    "palette": { "source": "extract", "max_colors": 64 },
    "dither": { "mode": "off" }
  },
  "ink": { "enable": false },
  "post": { "despeckle": 1 }
}
